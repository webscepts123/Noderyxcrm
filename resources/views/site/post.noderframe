html lang="en"
  head
    meta charset="utf-8"
    meta name="viewport" content="width=device-width, initial-scale=1"
    meta name="description" content="{{post.seoDescription}}"
    meta name="robots" content="{{settings.robots}}"
    meta property="og:image" content="{{post.featuredImage}}"
    title "{{post.seoTitle}}"
    link rel="stylesheet" href="{{theme.stylesheet}}"
    link rel="stylesheet" href="/public/builder-content.css"
    if post.blocks
      link rel="stylesheet" href="/builder-style/{{post.type}}/{{post.slug}}"
  body.site-body data-layout="{{post.layout}}"
    header.site-header
      div.wrap.header-row
        a.brand href="/" "{{settings.siteName}}"
        nav.site-nav
          for item in navigation
            a href="{{item.url}}" "{{item.label}}"
          if user
            a href="/nodecms" "Dashboard"
    main.article-main
      article.article-wrap
        a.category href="/category/{{post.categorySlug}}" "{{post.category}}"
        h1 "{{post.title}}"
        p.article-lead "{{post.excerpt}}"
        div.meta "{{post.date}} · By {{post.author}}"
        if post.featuredImage
          img.article-image src="{{post.featuredImage}}" alt="{{post.title}}"
        div.article-content
          if post.blocks
            for block in post.blocks
              section.nvb-content data-block-index="{{block.index}}" data-visibility="{{block.visibility}}" data-widget="{{block.type}}"
                if block.type == "hero"
                  if block.url
                    img.nvb-image src="{{block.url}}" alt="{{block.alt}}"
                  h2 "{{block.text}}"
                  p "{{block.alt}}"
                if block.type == "heading"
                  h2 "{{block.text}}"
                if block.type == "text"
                  p "{{block.text}}"
                if block.type == "image"
                  if block.url
                    img.nvb-image src="{{block.url}}" alt="{{block.alt}}"
                if block.type == "button"
                  a.nvb-button href="{{block.url}}" "{{block.text}}"
                if block.type == "columns"
                  div.nvb-columns
                    p "{{block.text}}"
                    p "{{block.alt}}"
                if block.type == "quote"
                  p.nvb-quote "{{block.text}}"
                  span "{{block.alt}}"
                if block.type == "divider"
                  div.nvb-divider
                if block.type == "spacer"
                  div.nvb-spacer
                if block.type == "card"
                  if block.url
                    img.nvb-image src="{{block.url}}" alt="{{block.alt}}"
                  h3 "{{block.text}}"
                  p "{{block.alt}}"
                if block.type == "cta"
                  h2 "{{block.text}}"
                  a.nvb-button href="{{block.url}}" "{{block.alt}}"
                if block.type == "list"
                  ul
                    for line in block.lines
                      li "{{line}}"
                if block.type == "testimonial"
                  p.nvb-quote "{{block.text}}"
                  span.nvb-person "{{block.name}}"
                    if block.role
                      span "{{block.role}}"
                if block.type == "icon-box"
                  div.nvb-ib-mark
                  h3 "{{block.text}}"
                  p "{{block.alt}}"
                if block.type == "counter"
                  strong "{{block.text}}"
                  span "{{block.alt}}"
                if block.type == "progress"
                  div.nvb-progress-label
                    span "{{block.progressLabel}}"
                    span "{{block.progressPercent}}%"
                  div.nvb-progress-track
                    div class="nvb-progress-fill nvb-p{{block.progressPercent}}"
                if block.type == "alert"
                  if block.alt
                    strong "{{block.alt}}"
                  p "{{block.text}}"
                if block.type == "team"
                  if block.url
                    img.nvb-image src="{{block.url}}" alt="{{block.text}}"
                  h3 "{{block.text}}"
                  if block.alt
                    span.nvb-person-role "{{block.alt}}"
                if block.type == "social-icons"
                  div.nvb-social
                    for item in block.items
                      a href="{{item.url}}" "{{item.label}}"
                if block.type == "accordion"
                  for item, i in block.items
                    input type="checkbox" id="acc-{{block.index}}-{{i}}" class="nvb-accordion-input"
                    label.nvb-accordion-label for="acc-{{block.index}}-{{i}}" "{{item.q}}"
                    div.nvb-accordion-panel "{{item.a}}"
                if block.type == "tabs"
                  for item, i in block.items
                    if i == 0
                      input type="radio" name="tabs-{{block.index}}" id="tabs-{{block.index}}-{{i}}" class="nvb-tab-input" checked=""
                    else
                      input type="radio" name="tabs-{{block.index}}" id="tabs-{{block.index}}-{{i}}" class="nvb-tab-input"
                    label.nvb-tab-label for="tabs-{{block.index}}-{{i}}" "{{item.q}}"
                    div.nvb-tab-panel "{{item.a}}"
                if block.type == "pricing"
                  div.nvb-pricing
                    h3 "{{block.text}}"
                    span.nvb-price "{{block.price}}"
                    ul
                      for feature in block.features
                        li "{{feature}}"
                    if block.url
                      a.nvb-button href="{{block.url}}" "Choose plan"
                if block.type == "table"
                  div class="nvb-table nvb-cols-{{block.columnCount}}"
                    for row in block.rows
                      if row.header
                        for cell in row.cells
                          span.nvb-cell.nvb-cell-head "{{cell}}"
                      else
                        for cell in row.cells
                          span.nvb-cell "{{cell}}"
          else
            p "{{post.content}}"
        if allowComments
          section.comments-section
            h2 "Comments"
            if commentSent
              div.notice "Your comment is awaiting moderation."
            for comment in comments
              article.comment
                strong "{{comment.name}}"
                p "{{comment.content}}"
            form.panel.stack method="post" action="/post/{{post.slug}}/comments"
              input type="hidden" name="_csrf" value="{{csrfToken}}"
              h2 "Leave a comment"
              label "Name"
                input name="name" required=""
              label "Email"
                input type="email" name="email" required=""
              label "Comment"
                textarea name="content" rows="5" required=""
              button.primary type="submit" "Submit comment"
    footer.site-footer
      div.wrap "© {{settings.siteName}} · Powered by Noderyx CMS"
