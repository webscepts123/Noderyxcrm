html lang="en"
  head
    meta charset="utf-8"
    meta name="viewport" content="width=device-width, initial-scale=1"
    title "{{heading}} — Noderyx CMS"
    link rel="stylesheet" href="/public/cms.css"
    script src="/public/cms-admin.js" defer=""
  body.admin-body
    div.sidebar
      a.admin-brand href="/nodecms" "Noderyx CMS"
      nav.admin-nav
        a href="/nodecms" "Dashboard"
        p.nav-section "Content"
        a href="/nodecms/posts" "Posts"
        a href="/nodecms/posts?type=page" "Pages"
        a href="/nodecms/media" "Media"
        a href="/nodecms/categories" "Categories"
        a href="/nodecms/comments" "Comments"
        p.nav-section "Appearance"
        a href="/nodecms/menus" "Menus"
        a href="/nodecms/themes" "Themes"
        a href="/nodecms/plugins" "Plugins"
        p.nav-section "System"
        a href="/nodecms/users" "Users"
        a href="/nodecms/backups" "Backups"
        a href="/nodecms/integrations" "Integrations"
        a href="/nodecms/settings" "Settings & SEO"
    main.admin-main
      header.admin-top
        div
          p.kicker "Editor"
          h1 "{{heading}}"
      form.editor-grid method="post" action="/nodecms/posts/save"
        input type="hidden" name="_csrf" value="{{csrfToken}}"
        input type="hidden" name="id" value="{{post.id}}"
        input type="hidden" name="type" value="{{type}}"
        section.panel.stack
          label "Title"
            input.large-input type="text" name="title" value="{{post.title}}" required=""
          label "Permalink slug"
            input type="text" name="slug" value="{{post.slug}}" placeholder="generated-from-title"
          label "Excerpt"
            textarea name="excerpt" rows="3" "{{post.excerpt}}"
          if type == "page"
            input type="hidden" name="blocks" id="page-blocks-value" value=""
            input type="hidden" name="content" id="page-content-value" value="{{post.content}}"
            section.page-builder id="page-builder"
              div.builder-topbar
                strong "Visual Page Builder"
                div.builder-devices
                  button.builder-device.active type="button" data-width="desktop" "Desktop"
                  button.builder-device type="button" data-width="tablet" "Tablet"
                  button.builder-device type="button" data-width="mobile" "Mobile"
              div.builder-workspace
                section.builder-library
                  h3 "Layout"
                  div.widget-grid
                    button.builder-add type="button" draggable="true" data-type="hero" "Hero"
                    button.builder-add type="button" draggable="true" data-type="columns" "2 Columns"
                    button.builder-add type="button" draggable="true" data-type="spacer" "Spacer"
                    button.builder-add type="button" draggable="true" data-type="divider" "Divider"
                  h3 "Basic"
                  div.widget-grid
                    button.builder-add type="button" draggable="true" data-type="heading" "Heading"
                    button.builder-add type="button" draggable="true" data-type="text" "Text"
                    button.builder-add type="button" draggable="true" data-type="image" "Image"
                    button.builder-add type="button" draggable="true" data-type="button" "Button"
                    button.builder-add type="button" draggable="true" data-type="quote" "Quote"
                  p.muted "Drag a widget onto the canvas or click to add it."
                div.builder-stage
                  div.builder-canvas id="builder-canvas"
                    for block in post.blocks
                      article.builder-block draggable="true" data-id="{{block.id}}" data-type="{{block.type}}"
                        div.builder-block-head
                          span.drag-handle "⋮⋮"
                          strong "{{block.type}}"
                          div
                            button.builder-duplicate type="button" "Duplicate"
                            button.danger.builder-remove type="button" "Remove"
                        if block.type == "hero"
                          input.block-text value="{{block.text}}" placeholder="Hero headline" aria-label="Hero headline"
                          input.block-alt value="{{block.alt}}" placeholder="Hero supporting text" aria-label="Hero supporting text"
                          input.block-url value="{{block.url}}" placeholder="Background image URL (optional)" aria-label="Background image URL"
                        if block.type == "heading"
                          input.block-text value="{{block.text}}" placeholder="Section heading" aria-label="Heading text"
                        if block.type == "text"
                          textarea.block-text rows="5" placeholder="Write your content" aria-label="Text content" "{{block.text}}"
                        if block.type == "image"
                          input.block-url value="{{block.url}}" placeholder="Image URL" aria-label="Image URL"
                          input.block-alt value="{{block.alt}}" placeholder="Alternative text" aria-label="Alternative text"
                        if block.type == "button"
                          input.block-text value="{{block.text}}" placeholder="Button label" aria-label="Button label"
                          input.block-url value="{{block.url}}" placeholder="Button URL" aria-label="Button URL"
                        if block.type == "columns"
                          textarea.block-text rows="4" placeholder="Left column content" aria-label="Left column" "{{block.text}}"
                          textarea.block-alt rows="4" placeholder="Right column content" aria-label="Right column" "{{block.alt}}"
                        if block.type == "quote"
                          textarea.block-text rows="3" placeholder="Quotation" aria-label="Quotation" "{{block.text}}"
                          input.block-alt value="{{block.alt}}" placeholder="Author" aria-label="Quote author"
                        if block.type == "divider"
                          div.builder-divider
                        if block.type == "spacer"
                          div.builder-spacer "Spacing"
                  div.builder-empty id="builder-empty" "Drag widgets here to build your page."
          else
            label "Content"
              textarea.editor name="content" rows="16" required="" "{{post.content}}"
          h2 "Search preview"
          label "SEO title"
            input name="seoTitle" value="{{post.seoTitle}}" maxlength="70"
          label "SEO description"
            textarea name="seoDescription" rows="3" maxlength="170" "{{post.seoDescription}}"
        div.panel.stack.publish-box
          h2 "Publish"
          label "Status"
            select name="status"
              if post.status == "published"
                option value="published" selected="" "Published"
                option value="draft" "Draft"
              else
                option value="draft" selected="" "Draft"
                option value="published" "Published"
          if type == "post"
            label "Category"
              select name="categoryId"
                for category in categories
                  option value="{{category.id}}" "{{category.name}}"
          label "Featured image URL"
            input type="url" name="featuredImage" value="{{post.featuredImage}}" placeholder="https://..."
          button.primary type="submit" "Save {{type}}"
          if post.id
            a.button.secondary href="/nodecms/posts/{{post.id}}/revisions" "View revisions"
