html lang="en"
  head
    meta charset="utf-8"
    meta name="viewport" content="width=device-width, initial-scale=1"
    title "{{heading}} — Noderyx CMS"
    link rel="stylesheet" href="/public/cms.css"
    link rel="stylesheet" href="/public/cms-workspace.css"
    script src="/public/cms-admin.js" defer=""
    link rel="stylesheet" href="/public/visual-builder.css"
    link rel="stylesheet" href="/public/builder-content.css"
    script type="module" src="/public/visual-builder.js"
  body.admin-body
    div.sidebar
      a.admin-brand href="/nodecms" "Noderyx CMS"
      nav.admin-nav
        a href="/nodecms" "Dashboard"
        p.nav-section "Content"
        a href="/nodecms/posts" "Posts"
        a href="/nodecms/posts?type=page" "Pages"
        a href="/nodecms/media" "Media"
        a href="/nodecms/categories" "Categories"
        a href="/nodecms/comments" "Comments"
        p.nav-section "Workspace"
        a href="/nodecms/workspace/tasks" "Editorial tasks"
        a href="/nodecms/workspace/notes" "Team notes"
        p.nav-section "Appearance"
        a href="/nodecms/menus" "Menus"
        a href="/nodecms/themes" "Themes"
        a href="/nodecms/plugins" "Plugins"
        p.nav-section "System"
        a href="/nodecms/users" "Users"
        a href="/nodecms/backups" "Backups"
        a href="/nodecms/integrations" "Integrations"
        a href="/nodecms/settings" "Settings & SEO"
      form.logout method="post" action="/nodecms/logout"
        input type="hidden" name="_csrf" value="{{csrfToken}}"
        button type="submit" "Sign out"
    a.skip-link href="#workspace" "Skip to content"
    header.cms-toolbar
      a.toolbar-site href="/" "N / Visit site ↗"
      span.toolbar-label "Administration"
      a.toolbar-new href="/nodecms/posts/new" "+ New content"
      span.toolbar-user "{{user.name}}"
    main.admin-main id="workspace"
      header.admin-top
        div
          p.kicker "Editor"
          h1 "{{heading}}"
      form.editor-grid method="post" action="/nodecms/posts/save"
        input type="hidden" name="_csrf" value="{{csrfToken}}"
        input type="hidden" name="id" value="{{post.id}}"
        input type="hidden" name="type" value="{{type}}"
        section.panel.stack
          label "Title"
            input.large-input type="text" name="title" value="{{post.title}}" required=""
          label "Permalink slug"
            input type="text" name="slug" value="{{post.slug}}" placeholder="generated-from-title"
          label "Excerpt"
            textarea name="excerpt" rows="3" "{{post.excerpt}}"
          div.builder-launch
            h2 "Noderyx Visual Builder"
            p.muted "Build this post or page visually with widgets, templates, and responsive style controls. Included in core CMS."
            button.primary type="button" id="open-visual-builder" "Open full builder"
            p.muted id="builder-summary" "Your content stays in this editor until you save."
          textarea name="blocks" id="visual-builder-data" hidden="" "{{builderData}}"
          textarea id="visual-builder-media" hidden="" "{{builderMedia}}"
          label "Text content / fallback"
            textarea.editor name="content" id="visual-builder-content" rows="10" "{{post.content}}"
          p.muted "When visual widgets exist, they are displayed on your site instead of this text. Opening a blank builder imports this text as a widget."
          h2 "Search preview"
          label "SEO title"
            input name="seoTitle" value="{{post.seoTitle}}" maxlength="70"
          label "SEO description"
            textarea name="seoDescription" rows="3" maxlength="170" "{{post.seoDescription}}"
        div.panel.stack.publish-box
          h2 "Publish"
          label "Page layout"
            select name="layout"
              option value="standard" "Standard article"
              if post.layout == "wide"
                option value="wide" selected="" "Full width content"
              else
                option value="wide" "Full width content"
              if post.layout == "canvas"
                option value="canvas" selected="" "Blank canvas (no site header/footer)"
              else
                option value="canvas" "Blank canvas (no site header/footer)"

          label "Status"
            select name="status"
              if post.status == "published"
                option value="published" selected="" "Published"
                option value="draft" "Draft"
              else
                option value="draft" selected="" "Draft"
                option value="published" "Published"
          if type == "post"
            label "Category"
              select name="categoryId"
                for category in categories
                  if category.selected
                    option value="{{category.id}}" selected="" "{{category.name}}"
                  else
                    option value="{{category.id}}" "{{category.name}}"
          label "Featured image URL"
            input type="url" name="featuredImage" value="{{post.featuredImage}}" placeholder="https://..."
          button.primary type="submit" "Save {{type}}"
          if post.id
            a.button.secondary href="/nodecms/posts/{{post.id}}/revisions" "View revisions"
